OMNYID_DOMAIN=omnyid.com
OMNYID_HOMESERVER_URL=https://api.omnyid.com
OMNYID_AFP_DELEGATION=api.omnyid.com:443
POSTGRES_USER=afp
POSTGRES_DB=afp
POSTGRES_PASSWORD=
POSTGRES_PASSWORD_FILE=.secrets/postgres_password
DATABASE_URL=
DATABASE_URL_FILE=.secrets/database_url
OMNYID_BACKUP_DIR=/var/backups/omnyid
OMNYID_AGENT_ID=agent:you@omnyid.com
OMNYID_GATEWAY_AGENT_ID=agent:email-gateway@omnyid.com
OMNYID_PUBLIC_KEY_HEX=
OMNYID_SIGNING_KEY_HEX=
OMNYID_SIGNING_KEY_HEX_FILE=.secrets/omnyid_signing_key_hex
OMNYID_ENCRYPTION_KEY_HEX=
OMNYID_ENCRYPTION_KEY_HEX_FILE=.secrets/omnyid_encryption_key_hex
OMNYID_SESSION_SECRET_FILE=.secrets/omnyid_session_secret
COMPOSIO_API_KEY_FILE=.secrets/composio_api_key
# Optional release/deploy gate for staging or pre-release validation.
OMNYID_VERIFY_COMPOSIO_LIVE=false
# Production readiness defaults to requiring healthy daemon heartbeats in /readyz.
# Set to false only during a controlled incident if you need readiness to ignore stale daemons temporarily.
OMNYID_READYZ_REQUIRE_HEALTHY_DAEMONS=true
# Keep public operational endpoints token-gated if you enable them on a private network edge.
OMNYID_OPERATIONAL_ENDPOINT_TOKEN_FILE=.secrets/omnyid_operational_endpoint_token
# Optional override for a mock or staging Composio endpoint.
# OMNYID_COMPOSIO_API_BASE_URL=
OMNYID_RECIPIENT_KEYS_JSON={}
OMNYID_EMAIL_ADDRESS=you@omnyid.com
OMNYID_MAIL_PROVIDER=gmail
OMNYID_IMAP_POLL_SECONDS=30
OMNYID_GMAIL_CLIENT_ID=
OMNYID_GMAIL_CLIENT_SECRET=
OMNYID_GMAIL_CLIENT_SECRET_FILE=.secrets/omnyid_gmail_client_secret
OMNYID_GMAIL_REDIRECT_URI=https://api.omnyid.com/gmail/callback
OMNYID_GMAIL_REFRESH_TOKEN=
OMNYID_GMAIL_REFRESH_TOKEN_FILE=.secrets/omnyid_gmail_refresh_token
OMNYID_GMAIL_USER_ID=me
OMNYID_GOOGLE_CLIENT_ID=
FROM_ADDRESS=you@omnyid.com
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
SMTP_PASS_FILE=.secrets/omnyid_smtp_pass
SMTP_PORT=587
# Wedding vendor relay is a separate, fail-closed transport. It is intentionally
# disabled while the existing Gmail gateway remains the live continuity path.
# Do not point either secret at Gmail credentials.
OMNYID_VENDOR_MAIL_ENABLED=false
OMNYID_VENDOR_MAIL_PROVIDER=disabled
OMNYID_VENDOR_MAIL_MASK_DOMAIN=mail.omnyid.com
OMNYID_VENDOR_MAIL_CLOUDFLARE_API_TOKEN_FILE=.secrets/omnyid_vendor_mail_cloudflare_api_token
OMNYID_VENDOR_MAIL_RESEND_API_KEY_FILE=.secrets/omnyid_vendor_mail_resend_api_key
OMNYID_VENDOR_MAIL_WORKER_SHARED_SECRET_FILE=.secrets/omnyid_vendor_mail_worker_shared_secret
OMNYID_VENDOR_MAIL_RESEND_WEBHOOK_SECRET_FILE=.secrets/omnyid_vendor_mail_resend_webhook_secret
OMNYID_IMAP_PASSWORD_FILE=.secrets/omnyid_imap_password
OMNYID_ANTHROPIC_KEY_FILE=.secrets/omnyid_anthropic_api_key
OMNYID_RUNPOD_API_KEY_FILE=.secrets/omnyid_runpod_api_key
OMNYID_OPENAI_API_KEY_FILE=.secrets/omnyid_openai_api_key
# Wedding vendor live-search providers. Keep raw keys server-side; use *_FILE for
# production secrets where available.
OMNYID_BRAVE_SEARCH_API_KEY_FILE=.secrets/omnyid_brave_search_api_key
OMNYID_EXA_SEARCH_API_KEY_FILE=.secrets/omnyid_exa_search_api_key
OMNYID_GOOGLE_PLACES_API_KEY_FILE=.secrets/omnyid_google_places_api_key
# Provider-native alias is also supported by the server resolver.
GOOGLE_PLACES_API_KEY_FILE=.secrets/google_places_api_key
# Wedding-template access defaults on when an admin key is present; set false to disable.
OMNYID_ADMIN_TOOL_BRAVE_SEARCH_API_WEDDING_TEMPLATE_ENABLED=true
OMNYID_ADMIN_TOOL_EXA_SEARCH_API_WEDDING_TEMPLATE_ENABLED=true
OMNYID_ADMIN_TOOL_GOOGLE_PLACES_API_WEDDING_TEMPLATE_ENABLED=true
OMNYID_OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OMNYID_OVERPASS_CONTACT_EMAIL=
OMNYID_OVERPASS_RATE_LIMIT_PER_MINUTE=30
# Admin shared-tool policy. These are non-secret enablement and quota labels;
# provider keys stay server-side or in connected provider secret files.
OMNYID_ADMIN_THIRD_PARTY_TOOL_POLICY_FILE=/var/lib/omnyid/admin-third-party-tool-policy.json
OMNYID_ADMIN_TOOL_GOOGLE_MAPS_PLATFORM_ALL_USERS_ENABLED=false
OMNYID_ADMIN_TOOL_GOOGLE_MAPS_PLATFORM_WEDDING_TEMPLATE_ENABLED=true
OMNYID_ADMIN_TOOL_GOOGLE_MAPS_PLATFORM_MONTHLY_FREE_QUOTA_LABEL=
OMNYID_ADMIN_TOOL_GOOGLE_MAPS_PLATFORM_QUOTA_USED_LABEL=
OMNYID_ADMIN_TOOL_WEATHERAPI_ALL_USERS_ENABLED=false
OMNYID_ADMIN_TOOL_WEATHERAPI_WEDDING_TEMPLATE_ENABLED=true
OMNYID_ADMIN_TOOL_WEATHERAPI_MONTHLY_FREE_QUOTA_LABEL=
OMNYID_ADMIN_TOOL_WEATHERAPI_QUOTA_USED_LABEL=
OMNYID_ADMIN_TOOL_TWILIO_MESSAGING_ALL_USERS_ENABLED=false
OMNYID_ADMIN_TOOL_TWILIO_MESSAGING_WEDDING_TEMPLATE_ENABLED=false
OMNYID_ADMIN_TOOL_TWILIO_MESSAGING_MONTHLY_FREE_QUOTA_LABEL=
OMNYID_ADMIN_TOOL_TWILIO_MESSAGING_QUOTA_USED_LABEL=
OMNYID_ADMIN_TOOL_STRIPE_ALL_USERS_ENABLED=false
OMNYID_ADMIN_TOOL_STRIPE_WEDDING_TEMPLATE_ENABLED=false
OMNYID_ADMIN_TOOL_STRIPE_MONTHLY_FREE_QUOTA_LABEL=
OMNYID_ADMIN_TOOL_STRIPE_QUOTA_USED_LABEL=
OMNYID_ADMIN_TOOL_CLOUDINARY_ALL_USERS_ENABLED=false
OMNYID_ADMIN_TOOL_CLOUDINARY_WEDDING_TEMPLATE_ENABLED=false
OMNYID_ADMIN_TOOL_CLOUDINARY_MONTHLY_FREE_QUOTA_LABEL=
OMNYID_ADMIN_TOOL_CLOUDINARY_QUOTA_USED_LABEL=
# Admin wedding ops panel metrics. Root should be the Oracle disk mount shown to operators.
OMNYID_ADMIN_WEDDING_OPS_METRICS_ROOT=/
OMNYID_ADMIN_WEDDING_OPS_METRICS_SOURCE=oracle-cloud
# Admin-funded wedding AI routing. Leave disabled until audit receipts and budget guardrails
# are live; scope remains wedding-template background work only, excluding Master Agent queries.
OMNYID_WEDDING_ADMIN_AI_ROUTING_ENABLED=false
OMNYID_WEDDING_EVENT_QUOTE_PROJECTION_ENABLED=true
OMNYID_WEDDING_ONLINE_FALLBACK_ENABLED=true
OMNYID_WEDDING_ONLINE_CATALOG_ENRICHMENT_ENABLED=true
OMNYID_WEDDING_EXTERNAL_SEND_ENABLED=true
VITE_WEDDING_AUTOMATIC_SHORTLIST_ENABLED=true
OMNYID_WEDDING_ADMIN_AI_AUDIT_RECEIPTS_ENABLED=false
OMNYID_WEDDING_ADMIN_AI_DAILY_USD_LIMIT=
OMNYID_WEDDING_ADMIN_AI_DAILY_REQUEST_LIMIT=
OMNYID_WEDDING_ADMIN_AI_DAILY_TOKEN_LIMIT=
MINIO_ROOT_USER=omnyidminio
MINIO_ROOT_PASSWORD=
# Oracle host currently has coolify-proxy on 443/tcp+udp.
# Keep WebTransport disabled on this compose profile until dedicated QUIC ingress exists.
OMNYID_ENABLE_WEBTRANSPORT=false
# deploy-oracle.ps1 validates these host-side paths, uploads the referenced local files,
# and rewrites each *_FILE value to /run/secrets/<name> inside the remote container env.
# Production release-readiness and deployment rehearsal now also expect a real backup path.
# Simulator rollout defaults: synthesizer preview on, watcher preview off.
OMNYID_ENABLE_WATCHER_SIMULATOR=false
OMNYID_ENABLE_WATCHER_SIMULATOR_PROMOTION=false
OMNYID_ENABLE_WATCHER_SIMULATOR_SAMPLING=false
