{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnyid.dev/schemas/planning/constraint-evaluation.v1.json",
  "title": "OmnyID planning constraint evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evaluation_id", "constraint_ref", "candidate_ref", "result", "severity",
    "constraint_evidence_ref", "explanation_code", "evaluated_at"
  ],
  "properties": {
    "schema_version": {"const": "planning.constraint_evaluation.v1"},
    "evaluation_id": {"$ref": "#/$defs/id"},
    "constraint_ref": {"$ref": "#/$defs/id"},
    "candidate_ref": {"$ref": "#/$defs/id"},
    "result": {"enum": ["satisfied", "conflict", "unknown", "not_applicable"]},
    "severity": {"enum": ["blocking", "decision_relevant", "informational"]},
    "constraint_evidence_ref": {"$ref": "#/$defs/id"},
    "candidate_evidence_ref": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "explanation_code": {"enum": ["explicit_match", "explicit_conflict", "evidence_missing", "scope_mismatch", "candidate_not_applicable"]},
    "evaluated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"enum": ["satisfied", "conflict"]}}, "required": ["result"]},
      "then": {"required": ["candidate_evidence_ref"], "properties": {"candidate_evidence_ref": {"$ref": "#/$defs/id"}}}
    },
    {
      "if": {"properties": {"result": {"const": "unknown"}}, "required": ["result"]},
      "then": {"properties": {"explanation_code": {"const": "evidence_missing"}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[^@\\s]+$"}
  }
}
