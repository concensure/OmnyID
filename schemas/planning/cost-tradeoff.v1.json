{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnyid.dev/schemas/planning/cost-tradeoff.v1.json",
  "title": "OmnyID planning cost trade-off v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tradeoff_id", "candidate_decision_ref", "incremental_cost",
    "offset_options", "priority_impact", "unknown_cost_drivers", "assumptions"
  ],
  "properties": {
    "schema_version": {"const": "planning.cost_tradeoff.v1"},
    "tradeoff_id": {"$ref": "#/$defs/id"},
    "candidate_decision_ref": {"$ref": "#/$defs/id"},
    "incremental_cost": {"$ref": "#/$defs/known_money"},
    "forecast_before": {"oneOf": [{"$ref": "#/$defs/money_range"}, {"type": "null"}]},
    "forecast_after": {"oneOf": [{"$ref": "#/$defs/money_range"}, {"type": "null"}]},
    "offset_options": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["option_id", "category_ref", "saving_range", "evidence_refs"],
        "properties": {
          "option_id": {"$ref": "#/$defs/id"}, "category_ref": {"$ref": "#/$defs/id"},
          "saving_range": {"$ref": "#/$defs/money_range"},
          "evidence_refs": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "priority_impact": {"enum": ["preserved", "improved", "reduced", "unknown"]},
    "unknown_cost_drivers": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/id"}},
    "assumptions": {
      "type": "array", "maxItems": 20,
      "items": {"enum": ["current_quote", "category_allowance", "conservative_range", "quantity_unconfirmed", "tax_unconfirmed"]}
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[^@\\s]+$"},
    "money": {
      "type": "object", "additionalProperties": false, "required": ["amount_minor", "currency"],
      "properties": {"amount_minor": {"type": "integer", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}
    },
    "known_money": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["state", "amount", "evidence_ref"],
          "properties": {"state": {"const": "exact"}, "amount": {"$ref": "#/$defs/money"}, "evidence_ref": {"$ref": "#/$defs/id"}}
        },
        {"type": "object", "additionalProperties": false, "required": ["state"], "properties": {"state": {"const": "unknown"}}}
      ]
    },
    "money_range": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_minor", "maximum_minor", "currency", "evidence_refs"],
      "properties": {
        "minimum_minor": {"type": "integer", "minimum": 0}, "maximum_minor": {"type": "integer", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
