(cloudflare_only) {
    @not_cloudflare not remote_ip private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    abort @not_cloudflare
}

(security_headers) {
    header {
        Strict-Transport-Security "max-age=15552000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

(omnyid_proxy) {
    reverse_proxy homeserver:8080 {
        # GAP-089: use {client_ip} (the TLS peer address Caddy sees) rather than
        # {remote_host} (same value) or the incoming X-Forwarded-For header (spoofable).
        # This is the correct real-client IP when Caddy is the edge terminator.
        header_up X-Forwarded-For {client_ip}
    }
}

# File conversion endpoints accept up to 32 MB (HTML→PDF payload).
# Other routes use the tighter 4 MB default.
(conversion_proxy) {
    request_body {
        max_size 32MB
    }
    reverse_proxy homeserver:8080 {
        header_up X-Forwarded-For {client_ip}
    }
}

