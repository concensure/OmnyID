    }

    # `/srv/docs` is a deployment input, not a public-document repository.
    # Only the static site assets and legal pages belong at this origin.  The
    # deploy archive can also contain engineering notes, so reject internal
    # document formats before either static docs handler can resolve them.
    # `security.txt` remains a deliberate public text exception under
    # `/.well-known/`.
    @nonpublic_docs {
        path *.md *.tsx *.sql *.review *.csv
    }
    handle @nonpublic_docs {
        respond "Not found" 404
    }

    # Alias so the wedding site's relative "../docs/index.html" links resolve.
    # The catch-all handle{} below already serves the same /srv/docs content at "/".
    @public_docs_alias {
        path /docs/*
        not path /docs/*.md /docs/*.tsx /docs/*.sql /docs/*.review /docs/*.csv
    }

    # Eliminate duplicate root documents and extensionless aliases. `redir`
    # and `rewrite` run before the mutually-exclusive file-server handles, so
    # these rules cannot be shadowed by the final catch-all.
    @root_index path /index.html /docs/index.html
    redir @root_index / 308
    @privacy_alias path /privacy
    redir @privacy_alias /privacy.html 308
    @data_rights_alias path /data-rights
    redir @data_rights_alias /data-rights.html 308
    @security_alias path /security
    redir @security_alias /security.html 308
    @terms_alias path /terms
    redir @terms_alias /terms.html 308
    @vendors_alias path /vendors
    redir @vendors_alias /vendors.html 308

    # The strict catch-all below deliberately has no SPA fallback. Preserve
    # the one real root document explicitly while unknown paths remain 404.
    @root_home path /
    rewrite @root_home /index.html
    handle @public_docs_alias {
        uri strip_prefix /docs
        root * /srv/docs
        try_files {path} /index.html
        file_server
        header /index.html Cache-Control "no-cache, no-store, must-revalidate"
        header /app.js Cache-Control "no-cache, no-store, must-revalidate"
        header X-Robots-Tag "noindex, follow"
        header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-+TtZizzTI1w95JFUHKoSBQBkMcW73Ju4wKTkYgdZtTE=' 'sha256-xl/jzrGxWCaX9hNw19CWSya+urr1TdtPyFQD9Uo2Fkg=' https://accounts.google.com/gsi/client https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://images.unsplash.com https://lh3.googleusercontent.com https://*.googleusercontent.com; connect-src 'self' https://api.omnyid.com https://static.cloudflareinsights.com; font-src 'self' data: https://fonts.gstatic.com; frame-src https://accounts.google.com/gsi/; frame-ancestors 'none'; object-src 'none'"
    }

    # No explicit Cache-Control here previously meant browsers could apply
    # heuristic freshness caching (RFC 7234 4.2.2) to index.html/app.js with
    # no way to force a refresh, which reads as "the deploy didn't take" even
    # though the server already has the new file. Matches /workspace/'s
    # no-cache treatment of its own index.html above.
    handle {
        root * /srv/docs
        try_files {path} {path}.html =404
        file_server
        header /index.html Cache-Control "no-cache, no-store, must-revalidate"
        header /app.js Cache-Control "no-cache, no-store, must-revalidate"
        header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-+TtZizzTI1w95JFUHKoSBQBkMcW73Ju4wKTkYgdZtTE=' 'sha256-xl/jzrGxWCaX9hNw19CWSya+urr1TdtPyFQD9Uo2Fkg=' https://accounts.google.com/gsi/client https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://images.unsplash.com https://lh3.googleusercontent.com https://*.googleusercontent.com; connect-src 'self' https://api.omnyid.com https://static.cloudflareinsights.com; font-src 'self' data: https://fonts.gstatic.com; frame-src https://accounts.google.com/gsi/; frame-ancestors 'none'; object-src 'none'"
    }
}

