# Local dev launcher credentials (used by dev.ps1; not sent to production)
DEV_EMAIL=dev@omnyid.local
DEV_PASSWORD=devpassword123
DEV_DISPLAY_NAME=Dev User

OMNYID_AGENT_ID=agent:you@omnyid.com
OMNYID_GATEWAY_AGENT_ID=agent:email-gateway@omnyid.com
OMNYID_HOMESERVER_URL=https://api.omnyid.com
OMNYID_AFP_DELEGATION=api.omnyid.com:443
OMNYID_DOMAIN=omnyid.com
ACME_EMAIL=ops@omnyid.com
OMNYID_WAITLIST_EMAIL=hello@omnyid.com
OMNYID_PREVIEW_USERNAME=preview
OMNYID_PREVIEW_PASSWORD_HASH=
OMNYID_KEY_ID=main
OMNYID_PREVIOUS_KEY_IDS=
OMNYID_PUBLIC_KEY_HEX=
# OAuth CSRF state signing secret — must be set in production (see GAP-056)
OMNYID_SESSION_SECRET=
# AFP relay signing domain
OMNYID_SIGNING_KEY_HEX=
# AFP relay content encryption domain
OMNYID_ENCRYPTION_KEY_HEX=
# Provider OAuth token wrapping domain
OMNYID_PROVIDER_TOKEN_KEK_REF=
# User-supplied LLM/API secret domain
OMNYID_LLM_SECRET_REF=
OMNYID_RECIPIENT_KEYS_JSON={}
OMNYID_DISCOVERY_TRUST_MODE=strict
OMNYID_ENCRYPT_BY_DEFAULT=true
OMNYID_REQUIRE_ENCRYPTION=true
OMNYID_ALLOW_INSECURE_UNSIGNED=false
# Structured logging: set to "json" for machine-readable production logs (GAP-025)
LOG_FORMAT=json
# Base URL shown in transactional emails (verification, password reset) (GAP-018/019)
OMNYID_BASE_URL=https://omnyid.com
OMNYID_ALLOW_PLAINTEXT_STORAGE=false
OMNYID_ENABLE_SERVER_SUMMARIZATION=false
SEAWEEDFS_MASTER_URL=http://seaweedfs:9333
OMNYID_SEAWEEDFS_S3_ENDPOINT=http://seaweedfs:8333
OMNYID_SEAWEEDFS_ACCESS_KEY=omnyid
OMNYID_SEAWEEDFS_SECRET_KEY=omnyid-dev-secret
OMNYID_SEAWEEDFS_BUCKET=omnyid-attachments
OMNYID_SEAWEEDFS_PREFIX=archives
OMNYID_SEAWEEDFS_REGION=us-east-1
OMNYID_MAIL_PROVIDER=gmail
OMNYID_IMAP_POLL_SECONDS=30
OMNYID_EMAIL_ADDRESS=you@yourdomain.com
OMNYID_IMAP_PORT=993
OMNYID_TRANSPORT=webtransport
OMNYID_TRANSPORT_FALLBACK=websocket
OMNYID_ENABLE_WEBTRANSPORT=true
OMNYID_WEBTRANSPORT_BIND_ADDR=0.0.0.0:8443
OMNYID_WEBTRANSPORT_URL=
OMNYID_WEBTRANSPORT_CERT_PATH=
OMNYID_WEBTRANSPORT_KEY_PATH=
OMNYID_WEBTRANSPORT_CA_CERTS=
OMNYID_WEBTRANSPORT_INSECURE=false
OMNYID_ENABLE_INTERNAL_GRPC=false
OMNYID_INTERNAL_GRPC_ADDR=127.0.0.1:50051
OMNYID_SECRET_MANAGER_BACKEND=vault
OMNYID_SECRET_MANAGER_URL=
OMNYID_SECRET_MANAGER_NAMESPACE=omnyid/prod
OMNYID_HOSTING_PRIMARY=oracle-cloud
OMNYID_HOSTING_SECONDARY=ovhcloud
OMNYID_GMAIL_CLIENT_ID=
OMNYID_GMAIL_CLIENT_SECRET=
OMNYID_GMAIL_REDIRECT_URI=https://api.omnyid.com/gmail/callback
OMNYID_GMAIL_REFRESH_TOKEN=
OMNYID_GMAIL_USER_ID=me
OMNYID_GOOGLE_CLIENT_ID=
OMNYID_APPLE_CLIENT_ID=
OMNYID_APPLE_REDIRECT_URI=
OMNYID_MICROSOFT_CLIENT_ID=
OMNYID_MICROSOFT_CLIENT_SECRET=
OMNYID_MICROSOFT_REFRESH_TOKEN=
OMNYID_IMAP_HOST=
OMNYID_IMAP_USERNAME=
OMNYID_IMAP_PASSWORD=
OMNYID_SMTP_ATTACHMENT_LIMIT_MB=25
FROM_ADDRESS=you@yourdomain.com
SMTP_HOST=smtp.yourdomain.com
SMTP_USER=
SMTP_PASS=
# Third-party integrations API key (enables tool connections in Connected Apps)
EXTERNAL_CONNECTIONS_API_KEY=
COMPOSIO_API_KEY=
# Wedding vendor live-search providers. Keep these server-side; never expose raw keys to clients.
# Brave is useful for broad web/vendor discovery, Google Places for accurate place details,
# and OSM/Overpass as a free/open fallback for venue/florist/photographer-style discovery.
OMNYID_BRAVE_SEARCH_API_KEY=
OMNYID_EXA_SEARCH_API_KEY=
OMNYID_GOOGLE_PLACES_API_KEY=
# Also accepted for server-side Google Places lookup when using provider-native names.
GOOGLE_PLACES_API_KEY=
# Wedding-template access defaults on when an admin key is present; set false to disable.
OMNYID_ADMIN_TOOL_BRAVE_SEARCH_API_WEDDING_TEMPLATE_ENABLED=true
OMNYID_ADMIN_TOOL_EXA_SEARCH_API_WEDDING_TEMPLATE_ENABLED=true
OMNYID_ADMIN_TOOL_GOOGLE_PLACES_API_WEDDING_TEMPLATE_ENABLED=true
OMNYID_OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OMNYID_OVERPASS_CONTACT_EMAIL=
OMNYID_OVERPASS_RATE_LIMIT_PER_MINUTE=30
# Admin shared-tool policy for wedding planner and other templates.
# Set OMNYID_ADMIN_THIRD_PARTY_TOOL_POLICY_FILE to let the admin UI persist enable/disable toggles.
# Keep provider secrets server-side; these flags only decide whether admin-funded access is available.
OMNYID_ADMIN_THIRD_PARTY_TOOL_POLICY_FILE=
OMNYID_ADMIN_TOOL_GOOGLE_MAPS_PLATFORM_ALL_USERS_ENABLED=false
OMNYID_ADMIN_TOOL_GOOGLE_MAPS_PLATFORM_WEDDING_TEMPLATE_ENABLED=true
OMNYID_ADMIN_TOOL_GOOGLE_MAPS_PLATFORM_MONTHLY_FREE_QUOTA_LABEL=
OMNYID_ADMIN_TOOL_GOOGLE_MAPS_PLATFORM_QUOTA_USED_LABEL=
OMNYID_ADMIN_TOOL_WEATHERAPI_ALL_USERS_ENABLED=false
OMNYID_ADMIN_TOOL_WEATHERAPI_WEDDING_TEMPLATE_ENABLED=true
OMNYID_ADMIN_TOOL_WEATHERAPI_MONTHLY_FREE_QUOTA_LABEL=
OMNYID_ADMIN_TOOL_WEATHERAPI_QUOTA_USED_LABEL=
OMNYID_ADMIN_TOOL_TWILIO_MESSAGING_ALL_USERS_ENABLED=false
OMNYID_ADMIN_TOOL_TWILIO_MESSAGING_WEDDING_TEMPLATE_ENABLED=false
OMNYID_ADMIN_TOOL_TWILIO_MESSAGING_MONTHLY_FREE_QUOTA_LABEL=
OMNYID_ADMIN_TOOL_TWILIO_MESSAGING_QUOTA_USED_LABEL=
OMNYID_ADMIN_TOOL_STRIPE_ALL_USERS_ENABLED=false
OMNYID_ADMIN_TOOL_STRIPE_WEDDING_TEMPLATE_ENABLED=false
OMNYID_ADMIN_TOOL_STRIPE_MONTHLY_FREE_QUOTA_LABEL=
OMNYID_ADMIN_TOOL_STRIPE_QUOTA_USED_LABEL=
OMNYID_ADMIN_TOOL_CLOUDINARY_ALL_USERS_ENABLED=false
OMNYID_ADMIN_TOOL_CLOUDINARY_WEDDING_TEMPLATE_ENABLED=false
OMNYID_ADMIN_TOOL_CLOUDINARY_MONTHLY_FREE_QUOTA_LABEL=
OMNYID_ADMIN_TOOL_CLOUDINARY_QUOTA_USED_LABEL=
# Admin wedding ops panel: local/Oracle host metrics are shown only to operator accounts.
# Set the root to the mounted disk you want reported in the admin UI.
OMNYID_ADMIN_WEDDING_OPS_METRICS_ROOT=/
OMNYID_ADMIN_WEDDING_OPS_METRICS_SOURCE=local-dev
# Admin-funded wedding AI routing. Keep disabled until the backend can enforce tenant
# boundaries, audit receipts, and at least one positive daily budget/request/token cap.
# This applies only to wedding-template background work, not direct Master Agent queries.
OMNYID_WEDDING_ADMIN_AI_ROUTING_ENABLED=false
OMNYID_WEDDING_EVENT_QUOTE_PROJECTION_ENABLED=true
OMNYID_WEDDING_ONLINE_FALLBACK_ENABLED=true
OMNYID_WEDDING_ONLINE_CATALOG_ENRICHMENT_ENABLED=true
OMNYID_WEDDING_EXTERNAL_SEND_ENABLED=true
VITE_WEDDING_AUTOMATIC_SHORTLIST_ENABLED=true
OMNYID_WEDDING_ADMIN_AI_AUDIT_RECEIPTS_ENABLED=false
OMNYID_WEDDING_ADMIN_AI_DAILY_USD_LIMIT=
OMNYID_WEDDING_ADMIN_AI_DAILY_REQUEST_LIMIT=
OMNYID_WEDDING_ADMIN_AI_DAILY_TOKEN_LIMIT=
# Delegation master key: 32-byte random hex. All sub-agent delegation tokens are derived
# from this key via HKDF. If it is unset, all-zeros, or invalid, delegation issuance
# now fails closed instead of minting insecure predictable tokens. REQUIRED in production.
OMNYID_DELEGATION_MASTER_KEY_HEX=
# LLM inference — at least one of these is required for the command bar to use an LLM
OMNYID_CEREBRAS_API_KEY=
CEREBRAS_API_KEY=
OMNYID_MISTRAL_API_KEY=
MISTRAL_API_KEY=
OMNYID_ANTHROPIC_KEY=
ANTHROPIC_API_KEY=
OMNYID_WEDDING_OUTREACH_CEREBRAS_MODEL=qwen-3.8-27b
OMNYID_WEDDING_OUTREACH_MISTRAL_MODEL=mistral-small-latest
OMNYID_WEDDING_OUTREACH_ANTHROPIC_MODEL=claude-haiku-5-5
OMNYID_WEDDING_INTERPRETER_CEREBRAS_MODEL=qwen-3.8-27b
OMNYID_WEDDING_INTERPRETER_MISTRAL_MODEL=mistral-small-latest
OMNYID_WEDDING_INTERPRETER_ANTHROPIC_MODEL=claude-haiku-5-5
OMNYID_WEDDING_ENRICHMENT_CEREBRAS_MODEL=qwen-3.8-27b
OMNYID_WEDDING_ENRICHMENT_MISTRAL_MODEL=mistral-small-latest
OMNYID_WEDDING_ENRICHMENT_ANTHROPIC_MODEL=claude-haiku-5-5
OMNYID_WEDDING_QUOTE_NORMALISATION_CEREBRAS_MODEL=qwen-3.8-27b
OMNYID_WEDDING_QUOTE_NORMALISATION_MISTRAL_MODEL=mistral-small-latest
OMNYID_WEDDING_QUOTE_NORMALISATION_ANTHROPIC_MODEL=claude-haiku-5-5
OMNYID_QUOTATION_RELEASE_GATE=disabled
OMNYID_QUOTATION_RELEASE_GATE_VERSION=quotation.readiness.v1
OMNYID_QUOTATION_RELEASE_EVIDENCE_SHA=
OMNYID_QUOTATION_EXTRACTION_ENABLED=false
OMNYID_QUOTATION_RECOMMENDATION_ENABLED=false
OMNYID_QUOTATION_CLARIFICATION_DRAFT_ENABLED=false
OMNYID_QUOTATION_CLARIFICATION_SEND_ENABLED=false
OMNYID_QUOTATION_CLOSURE_ENABLED=false
OMNYID_QUOTATION_VENDOR_GRANTS_ENABLED=false
OMNYID_PLANNING_CONSTRAINT_LEDGER_ENABLED=false
OMNYID_PLANNING_CONSTRAINT_CAPTURE_ENABLED=false
OMNYID_PLANNING_EVALUATION_ENABLED=false
OMNYID_PLANNING_COST_TRADEOFFS_ENABLED=false
OMNYID_PLANNING_CRITICAL_PATH_ENABLED=false
OMNYID_PLANNING_VENDOR_CHANGES_ENABLED=false
OMNYID_PLANNING_INTERVENTIONS_ENABLED=false
VITE_PLANNING_CONSTRAINT_CAPTURE_ENABLED=false
VITE_PLANNING_CONSTRAINT_EVALUATION_ENABLED=false
VITE_PLANNING_COST_TRADEOFFS_ENABLED=false
VITE_PLANNING_CRITICAL_PATH_ENABLED=false
VITE_PLANNING_VENDOR_CHANGES_ENABLED=false
VITE_PLANNING_CONSTRAINT_INTERVENTION_ENABLED=false
VITE_PLANNING_UNIFIED_INTERVENTIONS_ENABLED=false
# NVIDIA NIM fallback uses the OpenAI-compatible endpoint at https://integrate.api.nvidia.com/v1.
# OMNYID_NVIDIA_API_KEY is used by OmnyID; NVIDIA_API_KEY is the script-compatible alias.
OMNYID_NVIDIA_API_KEY=
NVIDIA_API_KEY=
OMNYID_RUNPOD_API_KEY=
OMNYID_RUNPOD_ENDPOINT_ID=
# Stripe billing integration
# Keep Stripe credentials outside version control. Restricted keys (rk_*) are
# supported when they can read Products/Prices and create Checkout Sessions.
OMNYID_STRIPE_SECRET_KEY_FILE=
OMNYID_STRIPE_WEBHOOK_SECRET_FILE=
# Supply either a one-off Price ID or the Product ID with one active AUD price.
OMNYID_STRIPE_WEDDING_PRODUCT_ID=
OMNYID_STRIPE_PRO_PRICE_ID=
# This may be the site origin or the workspace URL; return links resolve to
# https://omnyid.com/workspace/ without duplicating /workspace.
OMNYID_WORKSPACE_BASE_URL=https://omnyid.com
OMNYID_STRIPE_SKIP_WEBHOOK_VERIFY=false
# Trusted proxy: set to true when the homeserver runs behind Caddy or a load balancer
# that sets X-Forwarded-For. Required for correct per-IP rate limiting (GAP-081).
OMNYID_BEHIND_TRUSTED_PROXY=false
OMNYID_VENDOR_CLAIM_WELCOME_EMAIL_ENABLED=false
# ElectricSQL sync endpoint (local-first Phase 9 feature)
OMNYID_ELECTRIC_URL=
# Runtime Docker Compose timeout in seconds (default 600)
OMNYID_DOCKER_COMPOSE_TIMEOUT_SECS=600
# Allowlist for autonomous outbound action execution (GAP-122); empty = no direct calls
OMNYID_ACTION_EXECUTE_ALLOWLIST=
# Gmail sync batch size (default 50)
OMNYID_GMAIL_SYNC_BATCH_SIZE=50
# Live Gmail provider smoke verification for the wedding vendor quote send path.
# This script is safe by default and refuses to send unless the confirmation value is exact.
# Use either OMNYID_VERIFY_SESSION_TOKEN or OMNYID_VERIFY_EMAIL/OMNYID_VERIFY_PASSWORD.
OMNYID_VERIFY_API_BASE=https://api.omnyid.com
OMNYID_VERIFY_SESSION_TOKEN=
OMNYID_VERIFY_EMAIL=
OMNYID_VERIFY_PASSWORD=
OMNYID_CONFIRM_LIVE_GMAIL_SEND=
OMNYID_VERIFY_GMAIL_FROM=admin@omnyid.com
OMNYID_VERIFY_GMAIL_TO=concensure@gmail.com
OMNYID_VERIFY_GMAIL_ID=
OMNYID_VERIFY_OUTPUT_PATH=
# Expose /metricsz, /healthz, /readyz without auth (only enable in private networks)
OMNYID_PUBLIC_OPERATIONAL_ENDPOINTS=false
# Optional token for token-gated /metricsz, /healthz, /readyz when public operational endpoints are enabled.
# In production prefer OMNYID_OPERATIONAL_ENDPOINT_TOKEN_FILE instead of plaintext env.
OMNYID_OPERATIONAL_ENDPOINT_TOKEN=
OMNYID_OPERATIONAL_ENDPOINT_TOKEN_FILE=
# In production, /readyz now fails closed on stale daemon heartbeats by default.
# Set to false only if you intentionally need readiness to ignore stale daemons during incident handling.
OMNYID_READYZ_REQUIRE_HEALTHY_DAEMONS=
# Simulator rollout defaults: synthesizer preview on, watcher preview off.
OMNYID_ENABLE_WATCHER_SIMULATOR=false
OMNYID_ENABLE_WATCHER_SIMULATOR_PROMOTION=false
OMNYID_ENABLE_WATCHER_SIMULATOR_SAMPLING=false
